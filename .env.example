# Copy this file to .env and fill in your values

# Signs the session cookies. Anyone who knows this value can forge a session,
# so it must be secret and unique to your install. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required when NODE_ENV=production - the app refuses to start without it.
SESSION_SECRET=change-this-to-something-random

# Port the app runs on (keep it closed on the firewall; the reverse proxy
# talks to it on localhost)
PORT=3000

# --- Production ---
# Set this when the app is reachable from the internet behind an HTTPS
# reverse proxy (Caddy/nginx). It makes Express trust the proxy's
# X-Forwarded-Proto header and marks the session cookie HTTPS-only.
# NODE_ENV=production
#
# Only if you knowingly run production without TLS (not recommended):
# COOKIE_SECURE=false

# --- Sandbox settings (optional - sensible defaults are used if unset) ---
# Code is compiled and run inside a throwaway Docker container per
# submission (no network access, memory/CPU/process limits). You need
# Docker installed and running for this to work - nothing else to
# configure. The openjdk image is pulled automatically the first time
# you run code (may take a minute); after that it's cached locally.

# SANDBOX_IMAGE=eclipse-temurin:21-jdk
# SANDBOX_TIME_LIMIT=30        # seconds, applies separately to compile and run
# SANDBOX_MEMORY_LIMIT=512m    # container limit; keep above SANDBOX_JVM_HEAP
# SANDBOX_JVM_HEAP=256m
# SANDBOX_CPUS=1
# SANDBOX_PIDS_LIMIT=64
# SANDBOX_NOFILE=256           # open files per container

# How many runs may happen at once. Roughly one CPU core and one
# SANDBOX_MEMORY_LIMIT each, so 4 slots want ~4 cores and ~2.5 GB free RAM.
# Everything beyond this waits in line; past SANDBOX_MAX_QUEUE waiting
# requests, students are asked to try again shortly.
# SANDBOX_SLOTS=4
# SANDBOX_MAX_QUEUE=60

# The account student code runs as inside the container ("nobody").
# SANDBOX_USER=65534:65534

# Where a run's working directory is created on the host. That directory is
# mounted read-write into the container as /work: it holds the project's data
# files, and it is where a program writes. Docker cannot add noexec to a bind
# mount - it inherits the host mount's options - so if you want student code
# to be unable to execute anything it writes, point this at a directory on a
# filesystem mounted noexec. Unset means the system temp directory.
# SANDBOX_WORK_BASE=/var/lib/classroom/work

# --- Automatic checking (optional) ---
# A diagram assignment can be checked against reference diagrams. The checker
# is a Python tool in checker/ with an environment of its own; create it once
# with `npm run setup:checker`. No Docker and no network are involved: the
# student's file is parsed, never executed.

# Which interpreter to run it with. Unset means checker/.venv, then `python`
# from PATH.
# UML_CHECK_PYTHON=C:/Users/you/java-classroom/checker/.venv/Scripts/python.exe

# UML_CHECK_TIMEOUT_MS=60000      # a check of a 50-class diagram takes ~1-2 s
# UML_CHECK_MAX_SOURCE_CHARS=200000

# How many checks may run at once, and how many may wait.
# CHECK_CONCURRENCY=2
# CHECK_QUEUE_LIMIT=40
