uploads/

# --- Database backups (npm run backup) - real student data, never commit ---
backups/

# --- Database ---
# The SQLite database holds real user accounts, password hashes and student
# code. It is created automatically on first run - never commit it.
classroom.db
classroom.db-shm
classroom.db-wal
*.sqlite
*.sqlite3

